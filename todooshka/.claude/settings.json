          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.ai-kit/bin/figma-prefetch.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
